{
    "name": "neuronworks/taskmanager",
    "description": "Project Activity & Task Management System — Neuronworks Junior Programmer Final Project",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --testdox --log-junit tests/phpunit-report.xml"
    }
}
